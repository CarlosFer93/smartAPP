# InsForge — Smart Preu App
# Copia este archivo como .env.local y completa los valores reales.
# .env.local NO se sube al repositorio.

# Server-side (privado)
INSFORGE_URL=
INSFORGE_ANON_KEY=

# Client-side (public)
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
NEXT_PUBLIC_INSFORGE_PROJECT_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
